; Engine configuration file.
; Mortofe — Godot 4.7.2 mobile-first baseline
config_version=5

[application]
config/name="Mortofe"
run/main_scene="res://main.tscn"
run/max_fps=0

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/energy_saving/keep_screen_on=true
window/frame_pacing/android/swappy_mode=2

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[physics]
common/physics_ticks_per_second=60

[layer_names]
2d_physics/layer_1="World"
2d_physics/layer_2="PlayerBody"
2d_physics/layer_3="EnemyBody"
2d_physics/layer_4="LegacyPlayerAttack"
2d_physics/layer_5="EnemyHitbox"
2d_physics/layer_6="PlayerHurtbox"
2d_physics/layer_7="EnemyHurtbox"
